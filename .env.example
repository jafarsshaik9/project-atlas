# Placeholders only. Existing broker/research/Telegram commands use process variables.
ATLAS_ENV=demo
# Research percentages use percentage points: 0.5 means 0.5%, not 50%.
ATLAS_STARTING_CAPITAL_GBP=1000.00
ATLAS_PLANNED_RISK_PER_TRADE_PCT=0.5
ATLAS_DAILY_LOSS_THRESHOLD_PCT=1
ATLAS_MAX_CONCURRENT_PLANNED_RISK_PCT=1
TRADING212_API_KEY=replace_with_demo_api_key
TRADING212_API_SECRET=replace_with_demo_api_secret
# Optional Phase 2C settings. No .env file is loaded automatically.
ATLAS_TELEGRAM_ENABLED=false
ATLAS_TELEGRAM_CARDS_ENABLED=false
ATLAS_TELEGRAM_BOT_TOKEN=replace_locally_never_commit
ATLAS_TELEGRAM_CHAT_ID=replace_locally_never_commit
# ATLAS_HISTORY_DB=local/atlas-history.sqlite3
# Massive only: explicitly authorised requests may lazily read this single variable
# from the local .env. No other .env variables are loaded/exported by that adapter.
MASSIVE_API_KEY=replace_with_massive_key
